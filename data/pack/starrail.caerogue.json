        "requirements": [],
        "steps": [
          {
            "kind": "branch",
            "condition": "{satisfy({friendly}, {unit}.name==遐蝶)}.effect[castorice_effect_usedblade].count < 1",
            "then": [
              {
                "kind": "branch",
                "condition": "{satisfy({friendly}, {unit}.id != deathdragon and {unit}.effect[castorice_effect_mooncocoon].count == 0)}.count > 0",
                "then": [
                  {
                    "kind": "addEffect",
                    "target": "{target}",
                    "effectId": "castorice_effect_mooncocoon",
                    "stacks": "1",
                    "expressionMode": "formula",
                    "targetExpression": "{satisfy({friendly}, {unit}.id != deathdragon and {unit}.effect[castorice_effect_mooncocoon].count == 0)}",
                    "legacyTarget": "chosen"
                  }
                ],
                "elseSteps": [],
                "expressionMode": "formula"
              }
            ],
            "elseSteps": [
              {
                "kind": "removeEffect",
                "target": "{self}",
                "effectId": "castorice_effect_mooncocoon",
                "stacks": "9999",
                "force": true,
                "expressionMode": "formula",
                "targetExpression": "{friendly}",
                "legacyTarget": "self"
              }
            ],
            "expressionMode": "formula"
          }
        ]
