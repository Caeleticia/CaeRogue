        "trigger": {
          "event": "continuous",
          "condition": "<({satisfy({friendly}, {unit}.name==遐蝶)}.effect[castorice_effect_usedblade].count < 1 and {satisfy({friendly}, {unit}.id != deathdragon and {unit}.effect[castorice_effect_mooncocoon].count == 0)}.count > 0) or ({satisfy({friendly}, {unit}.name==遐蝶)}.effect[castorice_effect_usedblade].count >= 1 and {satisfy({friendly}, {unit}.effect[castorice_effect_mooncocoon].count > 0)}.count > 0)>"
